DATABASE_URL=postgres://nexus:nexus@localhost:5432/nexuschat
PORT=3001
RUST_LOG=info,nexus_server=debug
JWT_SECRET=change-me-to-a-long-random-string-of-32+chars
# S3-совместимое хранилище файлов; локально — MinIO из docker-compose
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=nexuschat
S3_ACCESS_KEY=nexus
S3_SECRET_KEY=nexus-dev-secret-key-placeholder
S3_REGION=us-east-1
# Папка собранного клиента (pnpm build); если задана, сервер отдаёт его сам
# CLIENT_DIST=../client/dist
