{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "NexusChat",
  "version": "0.1.0",
  "identifier": "com.nexuschat.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "https://chat.example.com"
  },
  "app": {
    "windows": [
      {
        "title": "NexusChat",
        "width": 1200,
        "height": 800,
        "minWidth": 380,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/OWNER/REPO/releases/latest/download/latest.json"
      ],
      "pubkey": "SET_BY_CI_FROM_TAURI_UPDATER_PUBKEY",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
